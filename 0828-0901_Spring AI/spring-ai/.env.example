# .env 템플릿. 이 파일을 .env로 복사한 뒤 값을 채우세요.

# --- 필수 ---
# OpenAI API 키. 아직 비어 있으니 본인 키를 넣으세요.
# 이미 쉘에 export 해두셨다면  echo $OPENAI_API_KEY  로 확인해 그대로 붙여넣으면 됩니다.
OPENAI_API_KEY=

# OpenWeatherMap API 키 (09.tools, 10-2.mcp-server, 11.simple-agent에서 사용)
WEATHER_API_KEY=

# --- 선택 (기본값이 있어 비워둬도 동작) ---
# pgvector 컨테이너 계정
PGVECTOR_USERNAME=postgres
PGVECTOR_PASSWORD=postgres

# baai 프로필에서 쓰는 로컬 Ollama 임베딩
BAAI_OLLAMA_BASE_URL=http://localhost:11436
BAAI_EMBEDDING_MODEL=bge-m3

# --- 다른 챗 모델로 바꿀 때만 ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
