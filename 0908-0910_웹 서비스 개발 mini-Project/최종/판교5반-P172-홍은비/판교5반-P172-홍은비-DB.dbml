//
// DocuFit — 기업대출 제출서류 사전검수 및 보완관리 서비스
//
// 프로젝트 : DocuFit
// 작성자   : 판교5 / P172 / 홍은비
// 작성일   : 2026-09-08
// 버전     : v1.2
// 도구     : DBDiagram (https://dbml.dbdiagram.io/)
// 기준 문서 : 판교5반-P172-홍은비-요구사항정의서, 판교5반-P172-홍은비-화면설계서
//
// 설계 원칙
// 1) 모든 테이블에 PK를 두고 관계는 FK로 명시한다.
// 2) 화면·API에서 사용하지 않는 미래 기능용 테이블은 만들지 않는다.
// 3) 기업명·사업자등록번호는 교차검증의 기준값이므로 companies 로 분리해 한 곳에서만 관리한다.
// 4) 비밀번호와 초대 토큰은 해시로만 저장한다 (REQ-NFN-002).
// 5) 재업로드는 덮어쓰지 않고 문서 유형별 version_no 를 증가시킨다 (REQ-NFN-004).
// 6) OCR 원본값은 읽기 전용이며 사용자가 직접 수정하지 않는다 (요구사항정의서 1.9).
// 7) 보완 요청은 대상 문서 1건 단위이므로 reviews 에 단일 문서 유형 코드를 저장한다 (REQ-FUNC-006).
// 8) 업로드 주체를 submitted_documents.uploaded_by 로 남겨 문서 이력의 처리자를 조회한다 (REQ-FUNC-006).
//
// 핵심 데이터 흐름 (REQ-FUNC-001 → 003 → 004 → 006)
// 은행이 loan_applications + invitations 생성
//   → 기업 담당자가 초대 링크로 users 활성화
//   → submitted_documents INSERT (유형별 version_no +1)
//   → 외부 OCR 결과를 extracted_fields 에 저장
//   → 교차검증 결과를 validation_issues 에 기록
//   → 차단 오류 0건이면 loan_applications.status = REVIEW_PENDING
//   → 은행 담당자가 reviews 에 DOCUMENTS_APPROVED 또는 REVISION_REQUESTED 저장
//
// 요구사항 추적성 : REQ-ID → 테이블
// REQ-FUNC-001 → companies, invitations, users
// REQ-FUNC-002 → companies, loan_applications, submitted_documents, reviews
// REQ-FUNC-003 → submitted_documents, extracted_fields
// REQ-FUNC-004 → companies, loan_applications, submitted_documents, extracted_fields, validation_issues
// REQ-FUNC-005 → companies, loan_applications, reviews
// REQ-FUNC-006 → companies, loan_applications, users, reviews, submitted_documents, extracted_fields, validation_issues
// REQ-NFN-002  → users.password_hash, invitations.token_hash, users.role, users.company_id
// REQ-NFN-004  → submitted_documents.version_no, submitted_documents.ocr_retry_count, reviews
//


Table companies {
  id            bigint      [pk, increment]
  business_no   varchar(10) [not null, unique, note: '사업자등록번호 10자리, 하이픈 제외. 문서 간 BUSINESS_NO_MISMATCH 판정의 기준값 (REQ-FUNC-004)']
  name          varchar(100) [not null, note: '기업명. 문서 간 COMPANY_NAME_MISMATCH 판정의 기준값 (REQ-FUNC-004)']
  created_at    timestamp   [not null, default: `now()`]

  Note: '은행이 사전 등록하는 기업 정보. 교차검증 기준값을 한 곳에서만 관리한다.'
}


Table users {
  id            bigint      [pk, increment]
  role          varchar(20) [not null, note: 'COMPANY_USER | BANK_REVIEWER. 매 요청의 역할 검증에 사용 (REQ-NFN-002)']
  company_id    bigint      [ref: > companies.id, note: 'COMPANY_USER 만 값을 가진다. 소속 기업 외 신청 건 접근 차단(403)']
  login_id      varchar(100) [not null, unique, note: '아이디 또는 업무용 이메일 (REQ-FUNC-001)']
  password_hash varchar(60) [not null, note: '단방향 해시. 원문 저장·응답 반환 금지 (REQ-NFN-002)']
  name          varchar(50) [not null, note: '담당자명']
  activated_at  timestamp   [note: '초대 계정 활성화 시각. 은행 담당자는 사전 발급이므로 생성 시각과 같다']
  created_at    timestamp   [not null, default: `now()`]

  Note: '기업 고객 담당자와 은행 기업금융 담당자를 role 로 구분한다. 공개 회원가입은 제공하지 않는다.'
}


Table loan_applications {
  id                   bigint      [pk, increment]
  company_id           bigint      [ref: > companies.id, not null]
  application_no       varchar(30) [not null, unique, note: '접수번호. 기업·은행 양쪽 화면에 표시']
  product_name         varchar(100) [not null, note: '대출 상품명']
  required_fiscal_year int         [not null, note: '요구 재무제표 사업연도. FISCAL_YEAR_MISMATCH 판정 기준 (REQ-FUNC-004)']
  status               varchar(20) [not null, default: 'DRAFT', note: 'DRAFT | REVIEW_PENDING | REVISION_REQUESTED | RESUBMITTED | DOCUMENTS_APPROVED. DOCUMENTS_APPROVED 는 서류 확인 완료이며 대출 승인이 아니다']
  submitted_at         timestamp   [note: '최초 제출 또는 최근 재제출 시각. SCR-REV-001 ⑥ 정렬 기준']
  created_at           timestamp   [not null, default: `now()`]
  updated_at           timestamp

  Note: '은행이 사전 생성하는 서류 제출 건. 기업 고객이 직접 생성하지 않는다.'
}


Table invitations {
  id                bigint       [pk, increment]
  application_id    bigint       [ref: > loan_applications.id, not null, note: '초대는 특정 신청 건에 연결된다']
  company_id        bigint       [ref: > companies.id, not null, note: '활성화 시 입력한 사업자등록번호와 대조 (REQ-FUNC-001 AC-01)']
  email             varchar(100) [not null, note: '초대받은 담당자의 업무용 이메일. 활성화 시 수정 불가']
  token_hash        varchar(64)  [not null, unique, note: '초대 토큰 해시. 원문 저장 금지 (REQ-NFN-002)']
  expires_at        timestamp    [not null, note: '유효기간. 만료 시 401 재발급 안내 (REQ-FUNC-001 AC-02)']
  used_at           timestamp    [note: 'NULL 이면 미사용. 값이 있으면 재사용 불가 = 일회성 보장']
  activated_user_id bigint       [ref: > users.id, note: '활성화로 생성된 계정. 미사용 초대는 NULL']
  created_at        timestamp    [not null, default: `now()`]

  Note: '만료·사용 완료 시 은행이 새 초대를 발급하므로 한 신청 건에 여러 행이 쌓일 수 있다 (1:N).'
}


Table submitted_documents {
  id              bigint       [pk, increment]
  application_id  bigint       [ref: > loan_applications.id, not null]
  doc_type        varchar(30)  [not null, note: 'BUSINESS_LICENSE | TAX_CERTIFICATE | FINANCIAL_STATEMENT. MVP 고정 3종 코드']
  version_no      int          [not null, default: 1, note: '문서 유형별 버전. 재업로드 시 +1, 이전 파일을 덮어쓰지 않는다 (REQ-FUNC-003, REQ-NFN-004)']
  is_latest       boolean      [not null, default: true, note: '유형별 최신본 1건만 true. 화면 표시와 교차검증은 최신본만 사용']
  file_name       varchar(255) [not null, note: '원본 파일명. 화면 ⑤⑥⑦ 에 표시']
  file_path       varchar(500) [not null, note: '원본 저장 경로. 화면·로그에 노출 금지 (REQ-NFN-002)']
  file_size       int          [not null, note: '바이트. 10MB 초과 시 400 (REQ-FUNC-003 AC-01)']
  mime_type       varchar(50)  [not null, note: 'image/jpeg | image/png | application/pdf 만 허용']
  ocr_status      varchar(20)  [not null, default: 'PROCESSING', note: 'PROCESSING | COMPLETED | FAILED']
  ocr_retry_count int          [not null, default: 0, note: '재업로드 없이 분석만 재시도한 횟수. 최대 3회 (REQ-NFN-004)']
  uploaded_by     bigint       [ref: > users.id, not null, note: '업로드한 기업 고객 담당자. SCR-REV-002 ⑦ 이력의 처리자명을 이 FK로 조회한다 (REQ-FUNC-006)']
  uploaded_at     timestamp    [not null, default: `now()`]

  indexes {
    (application_id, doc_type, version_no) [unique, name: 'uq_doc_version']
    (application_id, doc_type, is_latest) [name: 'idx_doc_latest']
  }

  Note: '한 신청 건의 문서 유형별 제출 이력. 최신본과 이전본을 함께 보존해 은행이 버전을 비교한다. 재업로드 시 기존 최신본의 is_latest 를 false 로 바꾸고 새 버전을 true 로 저장하는 작업은 하나의 트랜잭션으로 처리한다.'
}


Table extracted_fields {
  id          bigint       [pk, increment]
  document_id bigint       [ref: > submitted_documents.id, not null]
  field_key   varchar(50)  [not null, note: 'COMPANY_NAME | BUSINESS_NO | REPRESENTATIVE | OPEN_DATE | ISSUED_AT | VALID_UNTIL | FISCAL_YEAR | REVENUE | TOTAL_ASSETS']
  field_value varchar(200) [note: 'OCR 원본값. 읽기 전용이며 사용자가 직접 수정하지 않는다 (요구사항정의서 1.9). 추출 실패 시 NULL']
  created_at  timestamp    [not null, default: `now()`]

  indexes {
    (document_id, field_key) [unique, name: 'uq_doc_field']
  }

  Note: '문서 1건에서 추출한 필드 집합. SCR-COMP-002 ⑥ 비교표와 SCR-REV-002 ⑤ 에 표시한다.'
}


Table validation_issues {
  id             bigint       [pk, increment]
  application_id bigint       [ref: > loan_applications.id, not null]
  document_id    bigint       [ref: > submitted_documents.id, note: 'MISSING_DOCUMENT 는 대상 문서가 없으므로 NULL']
  issue_type     varchar(40)  [not null, note: 'MISSING_DOCUMENT | EXPIRED_TAX_CERTIFICATE | COMPANY_NAME_MISMATCH | BUSINESS_NO_MISMATCH | FISCAL_YEAR_MISMATCH | OCR_SERVICE_FAILURE. 6종 모두 차단 오류다']
  target_doc_type varchar(30) [not null, note: '해결해야 할 문서 유형. SCR-COMP-002 ⑤ 해결 행동이 이 값으로 SCR-COMP-001 카드로 이동한다']
  message        varchar(300) [not null, note: '사용자에게 보이는 문구 (화면설계서 5.5)']
  is_resolved    boolean      [not null, default: false, note: '재업로드 후 재검증 시 갱신. false 가 하나라도 있으면 최종 제출 불가 (422)']
  detected_at    timestamp    [not null, default: `now()`]

  indexes {
    (application_id, is_resolved) [name: 'idx_issue_open']
  }

  Note: 'MVP 는 경고 등급을 두지 않으므로 모든 행이 차단 오류다.'
}


Table reviews {
  id              bigint       [pk, increment]
  application_id  bigint       [ref: > loan_applications.id, not null]
  reviewer_id     bigint       [ref: > users.id, not null, note: 'role = BANK_REVIEWER 인 사용자만 저장된다 (REQ-NFN-002)']
  decision        varchar(30)  [not null, note: 'DOCUMENTS_APPROVED | REVISION_REQUESTED']
  target_doc_type varchar(30)  [note: '보완 대상 문서 1건. DOCUMENTS_APPROVED 이면 NULL (REQ-FUNC-006 AC-02)']
  reason          varchar(500) [note: '기업 고객에게 보이는 보완 사유. DOCUMENTS_APPROVED 이면 NULL']
  decided_at      timestamp    [not null, default: `now()`]

  indexes {
    (application_id, decided_at) [name: 'idx_review_history']
  }

  Note: '검토 이력. SCR-REV-001 ⑦ 의 보완 요청 횟수는 decision = REVISION_REQUESTED 행의 개수로 집계한다.'
}


// 관계 요약 (모두 1:N, M:N 없음)
// companies          1:N users
// companies          1:N loan_applications
// companies          1:N invitations
// loan_applications  1:N invitations
// loan_applications  1:N submitted_documents
// loan_applications  1:N validation_issues
// loan_applications  1:N reviews
// submitted_documents 1:N extracted_fields
// submitted_documents 1:N validation_issues
// users              1:N reviews
// users              1:N submitted_documents (업로드 주체)
// users              1:N invitations (활성화된 계정)
